# 이 파일을 .env로 복사한 뒤 값을 채운다: cp .env.example .env
# docker compose와 ./gradlew bootRun이 모두 이 .env를 읽는다.

# order-service DB
ORDER_DB_NAME=orderdb
ORDER_DB_USERNAME=order_user
ORDER_DB_PASSWORD=change-me

# stock-service DB
STOCK_DB_NAME=stockdb
STOCK_DB_USERNAME=stock_user
STOCK_DB_PASSWORD=change-me
